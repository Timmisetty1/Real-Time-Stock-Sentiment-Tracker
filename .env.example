# Reddit API credentials (get from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=StockSentimentTracker/1.0

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here

# Database
DATABASE_URL=sqlite:///data/sentiment.db

# News sources (comma separated)
NEWS_SOURCES=https://finance.yahoo.com,https://www.marketwatch.com

# Target companies/stocks
TARGET_STOCKS=AAPL,GOOGL,MSFT,AMZN,TSLA
